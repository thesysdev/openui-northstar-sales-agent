# Copy to .env.local and fill in. Never commit .env.local.

# OpenUI Gateway / OpenUI Cloud key: https://console.thesys.dev/keys (or `npm run generate:apiKey`)
THESYS_API_KEY=

# Postgres connection string for a database with the `retail` schema
DATABASE_URL=

# Optional
# OPENUI_MODEL=anthropic/claude-sonnet-5.5
# OPENUI_DASHBOARD_MODEL=anthropic/claude-sonnet-5.5
# OPENUI_FOLLOWUPS_MODEL=
# DEMO_USER_ID=assistant-ui-dashboards-demo
# THESYS_BASE_URL=https://api.thesys.dev

# Optional: PostHog analytics, set only on the deployed demo.
# NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
